datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum InstitutionType {
  SCHOOL
  COLLEGE
  UNIVERSITY
  INSTITUTE
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum SubscriptionTier {
  COMMUNITY
  STARTER
  GROWTH
  ENTERPRISE
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum UserStatus {
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ParentRelationship {
  FATHER
  MOTHER
  GUARDIAN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  EXCUSED
}

enum LeaveType {
  CASUAL
  SICK
  EARNED
  MATERNITY
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ExamType {
  UNIT_TEST
  MIDTERM
  FINAL
  PRACTICAL
  ASSIGNMENT
  QUIZ
}

enum PublishStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum FeeFrequency {
  ONE_TIME
  MONTHLY
  QUARTERLY
  TERMLY
  ANNUALLY
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  CHEQUE
  BANK_TRANSFER
  UPI
  CARD
  ONLINE_GATEWAY
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

enum BookIssueStatus {
  ISSUED
  RETURNED
  OVERDUE
  LOST
}

enum NoticeAudience {
  ALL
  TEACHERS
  STUDENTS
  PARENTS
  STAFF
}

enum PayrollStatus {
  DRAFT
  CALCULATED
  APPROVED
  DISBURSED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum DiscountApplicability {
  TUITION_ONLY
  TRANSPORT_ONLY
  ALL_HEADS
}

// -------------------------------------------------------------
// IDENTITY & SAAS
// -------------------------------------------------------------

model Tenant {
  id               String            @id @default(uuid())
  code             String            @unique // Unique short code (e.g. GWIS)
  name             String
  type             InstitutionType   @default(SCHOOL)
  status           TenantStatus      @default(ACTIVE)
  address          String?
  city             String?
  state            String?
  country          String            @default("India")
  postalCode       String?
  phone            String?
  email            String?
  website          String?
  logoUrl          String?
  timezone         String            @default("Asia/Kolkata")
  currencyCode     String            @default("INR")
  settings         Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  subscriptions    Subscription[]
  entitlements     FeatureEntitlement[]
  users            User[]
  roles            Role[]
  userRoles        UserRole[]
  auditLogs        AuditLog[]
  refreshSessions  RefreshSession[]

  campuses         Campus[]
  academicYears    AcademicYear[]
  departments      Department[]
  classRooms       ClassRoom[]
  courses          Course[]
  semesters        Semester[]
  sections         Section[]
  subjects         Subject[]
  classSubjects    ClassSubject[]
  teacherAssignments TeacherAssignment[]
  timetableEntries TimetableEntry[]
  teacherSubstitutions TeacherSubstitution[]
  enrollments      Enrollment[]

  students         Student[]
  parentProfiles   ParentProfile[]
  studentParents   StudentParent[]
  teacherProfiles  TeacherProfile[]
  staffProfiles    StaffProfile[]
  staffAttendances StaffAttendance[]
  staffLeaveBalances StaffLeaveBalance[]
  leaveRequests    LeaveRequest[]

  studentAttendances StudentAttendance[]
  periodAttendances  PeriodAttendance[]
  exams            Exam[]
  examSubjects     ExamSubject[]
  assessments      Assessment[]
  markEntries      MarkEntry[]
  gradeScales      GradeScale[]
  reportCards      ReportCard[]

  assignments      Assignment[]
  assignmentSubmissions AssignmentSubmission[]
  learningMaterials LearningMaterial[]

  feeCategories    FeeCategory[]
  feeStructures    FeeStructure[]
  feeDiscountRules FeeDiscountRule[]
  studentFees      StudentFee[]
  invoices         Invoice[]
  invoiceLines     InvoiceLine[]
  payments         Payment[]
  paymentReversals PaymentReversal[]
  refunds          Refund[]
  expenses         Expense[]

  notices          Notice[]
  notifications    Notification[]
  outboundNotifications OutboundNotification[]
  libraryBooks     LibraryBook[]
  bookIssues       BookIssue[]
  transportRoutes  TransportRoute[]
  vehicles         Vehicle[]
  hostelRooms      HostelRoom[]
  inventoryItems   InventoryItem[]

  payrollPeriods   PayrollPeriod[]
  payrollRecords   PayrollRecord[]

  @@index([status])
  @@index([createdAt])
}

model SubscriptionPlan {
  id             String           @id @default(uuid())
  code           String           @unique
  name           String
  tier           SubscriptionTier @default(STARTER)
  description    String?
  price          Decimal          @default(0.00) @db.Decimal(12, 2)
  currencyCode   String           @default("INR")
  billingCycle   BillingCycle     @default(MONTHLY)
  maxStudents    Int              @default(500)
  maxStaff       Int              @default(50)
  maxCampuses    Int              @default(1)
  features       Json?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  subscriptions  Subscription[]
}

model Subscription {
  id                 String             @id @default(uuid())
  tenantId           String
  planId             String
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan               SubscriptionPlan   @relation(fields: [planId], references: [id])

  @@index([tenantId])
  @@index([planId])
  @@index([status])
}

model FeatureEntitlement {
  id          String   @id @default(uuid())
  tenantId    String
  featureKey  String
  isEnabled   Boolean  @default(true)
  limitValue  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, featureKey])
  @@index([tenantId])
}

model User {
  id              String           @id @default(uuid())
  tenantId        String?          // Nullable for Platform Super Admins
  email           String           @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  avatarUrl       String?
  status          UserStatus       @default(ACTIVE)
  isSuperAdmin    Boolean          @default(false)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  refreshSessions RefreshSession[]
  auditLogs       AuditLog[]
  notifications   Notification[]

  studentProfile  Student?
  parentProfile   ParentProfile?
  teacherProfile  TeacherProfile?
  staffProfile    StaffProfile?

  @@index([tenantId])
  @@index([status])
  @@index([isSuperAdmin])
}

model Role {
  id          String           @id @default(uuid())
  tenantId    String?          // Null for global system roles
  code        String
  name        String
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles   UserRole[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique // e.g. "students.read", "fees.collect"
  module      String           // e.g. "STUDENTS", "FEES", "ACADEMICS"
  name        String
  description String?
  createdAt   DateTime         @default(now())

  rolePermissions RolePermission[]

  @@index([module])
}

model RolePermission {
  id           String      @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime    @default(now())

  role         Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  tenantId  String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@index([tenantId])
}

model RefreshSession {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  tenantId   String?
  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant     Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String?
  userId     String?
  action     String   // CREATE, UPDATE, DELETE, LOGIN, EXPORT, APPROVE, PUBLISH
  entityType String   // USER, STUDENT, FEE, EXAM, RESULT, etc.
  entityId   String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

// -------------------------------------------------------------
// INSTITUTION & ACADEMICS
// -------------------------------------------------------------

model Campus {
  id         String   @id @default(uuid())
  tenantId   String
  code       String
  name       String
  address    String?
  phone      String?
  email      String?
  isMain     Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  departments Department[]
  classRooms ClassRoom[]
  students   Student[]
  teachers   TeacherProfile[]
  staff      StaffProfile[]
  expenses   Expense[]
  books      LibraryBook[]
  routes     TransportRoute[]
  vehicles   Vehicle[]
  hostelRooms HostelRoom[]
  inventoryItems InventoryItem[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model AcademicYear {
  id         String    @id @default(uuid())
  tenantId   String
  code       String    // e.g. "2025-2026"
  name       String    // e.g. "Academic Year 2025-26"
  startDate  DateTime
  endDate    DateTime
  isCurrent  Boolean   @default(false)
  isLocked   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  semesters  Semester[]
  sections   Section[]
  enrollments Enrollment[]
  teacherAssignments TeacherAssignment[]
  exams      Exam[]
  feeStructures FeeStructure[]
  studentFees StudentFee[]
  invoices   Invoice[]
  staffLeaveBalances StaffLeaveBalance[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([isCurrent])
}

model Department {
  id          String   @id @default(uuid())
  tenantId    String
  campusId    String?
  code        String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus      Campus?  @relation(fields: [campusId], references: [id], onDelete: SetNull)
  courses     Course[]
  subjects    Subject[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([campusId])
}

model ClassRoom {
  id         String   @id @default(uuid())
  tenantId   String
  campusId   String
  roomNumber String
  building   String?
  capacity   Int      @default(40)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus     Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  timetableEntries TimetableEntry[]

  @@unique([tenantId, campusId, roomNumber])
  @@index([tenantId])
  @@index([campusId])
}

model Course {
  id            String   @id @default(uuid())
  tenantId      String
  departmentId  String?
  code          String   // e.g. "GRADE-10", "BSC-CS"
  name          String
  description   String?
  durationYears Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  semesters     Semester[]
  sections      Section[]
  feeStructures FeeStructure[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([departmentId])
}

model Semester {
  id             String       @id @default(uuid())
  tenantId       String
  courseId       String
  academicYearId String
  name           String       // e.g. "Semester 1", "Term 1"
  semesterNumber Int          @default(1)
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([courseId])
  @@index([academicYearId])
}

model Section {
  id             String       @id @default(uuid())
  tenantId       String
  courseId       String?      // e.g. Class 10
  academicYearId String
  name           String       // e.g. "Section A"
  capacity       Int          @default(40)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course         Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  classSubjects  ClassSubject[]
  enrollments    Enrollment[]
  studentAttendances StudentAttendance[]
  timetableEntries TimetableEntry[]
  feeStructures  FeeStructure[]

  @@unique([tenantId, academicYearId, name, courseId])
  @@index([tenantId])
  @@index([courseId])
  @@index([academicYearId])
}

model Subject {
  id           String   @id @default(uuid())
  tenantId     String
  departmentId String?
  code         String
  name         String
  creditHours  Decimal? @db.Decimal(4, 2)
  isElective   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  classSubjects ClassSubject[]
  examSubjects ExamSubject[]
  timetableEntries TimetableEntry[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([departmentId])
}

model ClassSubject {
  id         String   @id @default(uuid())
  tenantId   String
  sectionId  String
  subjectId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section    Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  teacherAssignments TeacherAssignment[]
  assignments        Assignment[]
  learningMaterials  LearningMaterial[]

  @@unique([tenantId, sectionId, subjectId])
  @@index([tenantId])
  @@index([sectionId])
  @@index([subjectId])
}

model TeacherAssignment {
  id               String       @id @default(uuid())
  tenantId         String
  teacherProfileId String
  classSubjectId   String
  academicYearId   String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher          TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  classSubject     ClassSubject   @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  academicYear     AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([tenantId, teacherProfileId, classSubjectId, academicYearId])
  @@index([tenantId])
  @@index([teacherProfileId])
  @@index([classSubjectId])
  @@index([academicYearId])
}

model TimetableEntry {
  id               String         @id @default(uuid())
  tenantId         String
  sectionId        String
  subjectId        String
  teacherProfileId String
  classRoomId      String?
  dayOfWeek        Int            // 1 = Monday ... 7 = Sunday
  startTime        String         // "09:00"
  endTime          String         // "09:45"
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section          Section        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject          Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher          TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  classRoom        ClassRoom?     @relation(fields: [classRoomId], references: [id], onDelete: SetNull)
  substitutions    TeacherSubstitution[]
  periodAttendances PeriodAttendance[]

  @@index([tenantId])
  @@index([sectionId, dayOfWeek])
  @@index([teacherProfileId, dayOfWeek])
  @@index([classRoomId, dayOfWeek])
}

model TeacherSubstitution {
  id                   String         @id @default(uuid())
  tenantId             String
  timetableEntryId     String
  originalTeacherId    String
  substituteTeacherId  String
  date                 DateTime       @db.Date
  status               String         @default("ASSIGNED") // ASSIGNED, COMPLETED, CANCELLED
  remarks              String?
  assignedById         String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  tenant               Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timetableEntry       TimetableEntry @relation(fields: [timetableEntryId], references: [id], onDelete: Cascade)
  originalTeacher      TeacherProfile @relation("OriginalTeacherSubstitutions", fields: [originalTeacherId], references: [id], onDelete: Cascade)
  substituteTeacher    TeacherProfile @relation("SubstituteTeacherAssignments", fields: [substituteTeacherId], references: [id], onDelete: Cascade)

  @@unique([tenantId, timetableEntryId, date])
  @@index([tenantId])
  @@index([timetableEntryId])
  @@index([originalTeacherId, date])
  @@index([substituteTeacherId, date])
}

model Enrollment {
  id             String       @id @default(uuid())
  tenantId       String
  studentId      String
  sectionId      String
  academicYearId String
  rollNumber     String?
  enrollmentDate DateTime     @default(now())
  status         String       @default("ACTIVE")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section        Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([tenantId, studentId, academicYearId])
  @@index([tenantId])
  @@index([studentId])
  @@index([sectionId])
  @@index([academicYearId])
}

// -------------------------------------------------------------
// STUDENTS & STAFF
// -------------------------------------------------------------

model Student {
  id               String       @id @default(uuid())
  tenantId         String
  campusId         String?
  userId           String       @unique
  admissionNumber  String
  admissionDate    DateTime     @default(now())
  dateOfBirth      DateTime
  gender           Gender       @default(MALE)
  bloodGroup       String?
  emergencyContact String?
  address          String?
  city             String?
  state            String?
  postalCode       String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus           Campus?      @relation(fields: [campusId], references: [id], onDelete: SetNull)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  studentParents   StudentParent[]
  enrollments      Enrollment[]
  attendances      StudentAttendance[]
  periodAttendances PeriodAttendance[]
  markEntries      MarkEntry[]
  reportCards      ReportCard[]
  submissions      AssignmentSubmission[]
  studentFees      StudentFee[]
  invoices         Invoice[]

  @@unique([tenantId, admissionNumber])
  @@index([tenantId])
  @@index([campusId])
  @@index([userId])
}

model ParentProfile {
  id             String       @id @default(uuid())
  tenantId       String
  userId         String       @unique
  occupation     String?
  annualIncome   Decimal?     @db.Decimal(12, 2)
  alternatePhone String?
  address        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentParents StudentParent[]

  @@index([tenantId])
  @@index([userId])
}

model StudentParent {
  id              String             @id @default(uuid())
  tenantId        String
  studentId       String
  parentProfileId String
  relationship    ParentRelationship @default(FATHER)
  isPrimaryContact Boolean           @default(false)
  canPickup       Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student         Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent          ParentProfile      @relation(fields: [parentProfileId], references: [id], onDelete: Cascade)

  @@unique([tenantId, studentId, parentProfileId])
  @@index([tenantId])
  @@index([studentId])
  @@index([parentProfileId])
}

model TeacherProfile {
  id             String       @id @default(uuid())
  tenantId       String
  campusId       String?
  userId         String       @unique
  employeeCode   String
  qualification  String?
  specialization String?
  joiningDate    DateTime     @default(now())
  designation    String?      @default("Teacher")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus         Campus?      @relation(fields: [campusId], references: [id], onDelete: SetNull)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  teacherAssignments TeacherAssignment[]
  timetableEntries   TimetableEntry[]
  originalSubstitutions TeacherSubstitution[] @relation("OriginalTeacherSubstitutions")
  substituteAssignments TeacherSubstitution[] @relation("SubstituteTeacherAssignments")
  assignments        Assignment[]
  learningMaterials  LearningMaterial[]
  leaveRequests      LeaveRequest[]
  staffAttendances   StaffAttendance[]

  @@unique([tenantId, employeeCode])
  @@index([tenantId])
  @@index([campusId])
  @@index([userId])
}

model StaffProfile {
  id             String       @id @default(uuid())
  tenantId       String
  campusId       String?
  userId         String       @unique
  employeeCode   String
  department     String?
  designation    String?
  joiningDate    DateTime     @default(now())
  employmentType String       @default("FULL_TIME")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus         Campus?      @relation(fields: [campusId], references: [id], onDelete: SetNull)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  attendances    StaffAttendance[]
  leaveBalances  StaffLeaveBalance[]
  leaveRequests  LeaveRequest[]
  payrollRecords PayrollRecord[]

  @@unique([tenantId, employeeCode])
  @@index([tenantId])
  @@index([campusId])
  @@index([userId])
}

model StaffAttendance {
  id               String           @id @default(uuid())
  tenantId         String
  staffProfileId   String?
  teacherProfileId String?
  date             DateTime         @db.Date
  status           AttendanceStatus @default(PRESENT)
  checkInTime      DateTime?
  checkOutTime     DateTime?
  remarks          String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff            StaffProfile?    @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  teacher          TeacherProfile?  @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([staffProfileId])
  @@index([teacherProfileId])
  @@index([date])
}

model StaffLeaveBalance {
  id             String       @id @default(uuid())
  tenantId       String
  staffProfileId String
  academicYearId String
  leaveType      LeaveType    @default(CASUAL)
  totalDays      Int          @default(12)
  usedDays       Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff          StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([tenantId, staffProfileId, academicYearId, leaveType])
  @@index([tenantId])
  @@index([staffProfileId])
  @@index([academicYearId])
}

model LeaveRequest {
  id               String          @id @default(uuid())
  tenantId         String
  staffProfileId   String?
  teacherProfileId String?
  leaveType        LeaveType       @default(CASUAL)
  startDate        DateTime        @db.Date
  endDate          DateTime        @db.Date
  totalDays        Int             @default(1)
  reason           String
  status           LeaveStatus     @default(PENDING)
  approvedById     String?
  approvalRemarks  String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff            StaffProfile?   @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  teacher          TeacherProfile? @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([staffProfileId])
  @@index([teacherProfileId])
  @@index([status])
}

// -------------------------------------------------------------
// ATTENDANCE & EXAMINATIONS
// -------------------------------------------------------------

model StudentAttendance {
  id           String           @id @default(uuid())
  tenantId     String
  studentId    String
  sectionId    String
  date         DateTime         @db.Date
  status       AttendanceStatus @default(PRESENT)
  remarks      String?
  recordedById String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section      Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, studentId, sectionId, date])
  @@index([tenantId])
  @@index([studentId])
  @@index([sectionId])
  @@index([date])
}

model PeriodAttendance {
  id               String           @id @default(uuid())
  tenantId         String           @db.VarChar(36)
  timetableEntryId String           @db.VarChar(36)
  studentId        String           @db.VarChar(36)
  date             DateTime         @db.Date
  status           AttendanceStatus @default(PRESENT)
  remarks          String?          @db.VarChar(255)
  recordedById     String?          @db.VarChar(36)
  createdAt        DateTime         @default(now())

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timetableEntry   TimetableEntry   @relation(fields: [timetableEntryId], references: [id], onDelete: Cascade)
  student          Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, timetableEntryId, studentId, date])
  @@index([tenantId, date])
  @@index([timetableEntryId])
  @@index([studentId])
}

model Exam {
  id             String        @id @default(uuid())
  tenantId       String
  academicYearId String
  name           String        // e.g. "Term 1 Examination"
  examType       ExamType      @default(MIDTERM)
  startDate      DateTime      @db.Date
  endDate        DateTime      @db.Date
  status         String        @default("SCHEDULED")
  publishStatus  PublishStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  examSubjects   ExamSubject[]
  reportCards    ReportCard[]

  @@index([tenantId])
  @@index([academicYearId])
  @@index([publishStatus])
}

model ExamSubject {
  id          String       @id @default(uuid())
  tenantId    String
  examId      String
  subjectId   String
  examDate    DateTime     @db.Date
  startTime   String?
  endTime     String?
  maxMarks    Decimal      @default(100.00) @db.Decimal(5, 2)
  passMarks   Decimal      @default(35.00) @db.Decimal(5, 2)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exam        Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject     Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  assessments Assessment[]
  markEntries MarkEntry[]

  @@unique([tenantId, examId, subjectId])
  @@index([tenantId])
  @@index([examId])
  @@index([subjectId])
}

model Assessment {
  id                  String      @id @default(uuid())
  tenantId            String
  examSubjectId       String
  name                String      // e.g. "Theory", "Practical"
  weightagePercentage Decimal     @default(100.00) @db.Decimal(5, 2)
  maxMarks            Decimal     @default(100.00) @db.Decimal(5, 2)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  tenant              Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  examSubject         ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([examSubjectId])
}

model MarkEntry {
  id            String      @id @default(uuid())
  tenantId      String
  examSubjectId String
  studentId     String
  marksObtained Decimal     @default(0.00) @db.Decimal(5, 2)
  isAbsent      Boolean     @default(false)
  remarks       String?
  recordedById  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  examSubject   ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, examSubjectId, studentId])
  @@index([tenantId])
  @@index([examSubjectId])
  @@index([studentId])
}

model GradeScale {
  id            String   @id @default(uuid())
  tenantId      String
  name          String   // e.g. "A+", "A", "B"
  minPercentage Decimal  @db.Decimal(5, 2)
  maxPercentage Decimal  @db.Decimal(5, 2)
  gradeLetter   String
  gradePoint    Decimal  @default(0.0) @db.Decimal(4, 2)
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model ReportCard {
  id          String   @id @default(uuid())
  tenantId    String
  studentId   String
  examId      String
  totalMarks  Decimal  @db.Decimal(7, 2)
  percentage  Decimal  @db.Decimal(5, 2)
  grade       String?
  gpa         Decimal? @db.Decimal(4, 2)
  rank        Int?
  remarks     String?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([tenantId, studentId, examId])
  @@index([tenantId])
  @@index([studentId])
  @@index([examId])
}

// -------------------------------------------------------------
// LEARNING (LMS)
// -------------------------------------------------------------

model Assignment {
  id               String       @id @default(uuid())
  tenantId         String
  classSubjectId   String
  teacherProfileId String
  title            String
  description      String?      @db.Text
  dueDate          DateTime
  maxMarks         Decimal      @default(20.00) @db.Decimal(5, 2)
  attachmentUrl    String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classSubject     ClassSubject   @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  teacher          TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  submissions      AssignmentSubmission[]

  @@index([tenantId])
  @@index([classSubjectId])
  @@index([teacherProfileId])
}

model AssignmentSubmission {
  id             String     @id @default(uuid())
  tenantId       String
  assignmentId   String
  studentId      String
  submissionText String?    @db.Text
  fileUrl        String?
  submittedAt    DateTime   @default(now())
  marksAwarded   Decimal?   @db.Decimal(5, 2)
  feedback       String?
  status         String     @default("SUBMITTED") // SUBMITTED, GRADED, RESUBMIT_REQUESTED
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignment     Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student        Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, assignmentId, studentId])
  @@index([tenantId])
  @@index([assignmentId])
  @@index([studentId])
}

model LearningMaterial {
  id               String         @id @default(uuid())
  tenantId         String
  classSubjectId   String
  teacherProfileId String
  title            String
  description      String?        @db.Text
  fileUrl          String
  fileType         String?        // PDF, VIDEO, DOC, LINK
  isPublished      Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classSubject     ClassSubject   @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  teacher          TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([classSubjectId])
  @@index([teacherProfileId])
}

// -------------------------------------------------------------
// FINANCE
// -------------------------------------------------------------

model FeeCategory {
  id            String         @id @default(uuid())
  tenantId      String
  name          String         // e.g. "Tuition Fee", "Admission Fee", "Exam Fee"
  description   String?
  isRefundable  Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feeStructures FeeStructure[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model FeeStructure {
  id             String       @id @default(uuid())
  tenantId       String
  academicYearId String
  categoryId     String
  courseId       String?
  sectionId      String?
  amount         Decimal      @db.Decimal(12, 2)
  dueDate        DateTime?
  frequency      FeeFrequency @default(TERMLY)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  category       FeeCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  course         Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  section        Section?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  studentFees    StudentFee[]

  @@index([tenantId])
  @@index([academicYearId])
  @@index([categoryId])
}

model StudentFee {
  id             String       @id @default(uuid())
  tenantId       String
  studentId      String
  feeStructureId String
  academicYearId String
  totalAmount    Decimal      @db.Decimal(12, 2)
  discountAmount Decimal      @default(0.00) @db.Decimal(12, 2)
  netAmount      Decimal      @db.Decimal(12, 2)
  status         String       @default("PENDING") // PENDING, PARTIALLY_PAID, PAID
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  invoiceLines   InvoiceLine[]

  @@unique([tenantId, studentId, feeStructureId, academicYearId])
  @@index([tenantId])
  @@index([studentId])
  @@index([feeStructureId])
  @@index([academicYearId])
}

model Invoice {
  id             String        @id @default(uuid())
  tenantId       String
  invoiceNumber  String
  studentId      String
  academicYearId String
  issueDate      DateTime      @default(now())
  dueDate        DateTime
  subtotal       Decimal       @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0.00) @db.Decimal(12, 2)
  discountAmount Decimal       @default(0.00) @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0.00) @db.Decimal(12, 2)
  status         InvoiceStatus @default(ISSUED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  lines          InvoiceLine[]
  payments       Payment[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([studentId])
  @@index([academicYearId])
  @@index([status])
}

model InvoiceLine {
  id           String      @id @default(uuid())
  tenantId     String
  invoiceId    String
  studentFeeId String?
  description  String
  quantity     Int         @default(1)
  unitPrice    Decimal     @db.Decimal(12, 2)
  totalAmount  Decimal     @db.Decimal(12, 2)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice      Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  studentFee   StudentFee? @relation(fields: [studentFeeId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([invoiceId])
  @@index([studentFeeId])
}

model Payment {
  id                   String        @id @default(uuid())
  tenantId             String
  invoiceId            String
  transactionReference String
  amount               Decimal       @db.Decimal(12, 2)
  paymentMethod        PaymentMethod @default(CASH)
  paymentStatus        PaymentStatus @default(SUCCESSFUL)
  paymentDate          DateTime      @default(now())
  gatewayOrderId       String?
  gatewayPaymentId     String?
  gatewaySignature     String?
  notes                String?
  recordedById         String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  tenant               Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice              Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  refunds              Refund[]
  reversal             PaymentReversal?

  @@unique([tenantId, transactionReference])
  @@index([tenantId])
  @@index([invoiceId])
  @@index([paymentStatus])
}

model PaymentReversal {
  id                String   @id @default(uuid())
  tenantId          String   @db.VarChar(100)
  paymentId         String   @unique @db.VarChar(100)
  reversalVoucherNo String   @db.VarChar(100)
  reason            String   @db.Text
  amount            Decimal  @db.Decimal(12, 2)
  status            String   @default("APPROVED") @db.VarChar(50) // PENDING, APPROVED, REJECTED
  requestedById     String   @db.VarChar(100)
  approvedById      String?  @db.VarChar(100)
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment           Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, reversalVoucherNo])
  @@index([tenantId])
  @@index([paymentId])
}

model FeeDiscountRule {
  id             String                @id @default(uuid())
  tenantId       String                @db.VarChar(100)
  name           String                @db.VarChar(150) // e.g. "Sibling Discount (2nd Child)", "Staff Ward Concession", "Merit Scholarship"
  code           String                @db.VarChar(100)
  description    String?               @db.Text
  discountType   DiscountType          @default(PERCENTAGE)
  value          Decimal               @db.Decimal(10, 2)
  applicableOn   DiscountApplicability @default(TUITION_ONLY)
  isAutomatic    Boolean               @default(false)
  criteria       Json?                 // e.g. { "siblingOrder": 2 } or { "staffWard": true }
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Refund {
  id              String   @id @default(uuid())
  tenantId        String
  paymentId       String
  refundReference String
  amount          Decimal  @db.Decimal(12, 2)
  reason          String?
  status          String   @default("COMPLETED")
  refundedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, refundReference])
  @@index([tenantId])
  @@index([paymentId])
}

model Expense {
  id          String   @id @default(uuid())
  tenantId    String
  campusId    String?
  category    String   // e.g. "UTILITIES", "MAINTENANCE", "SUPPLIES"
  title       String
  description String?
  amount      Decimal  @db.Decimal(12, 2)
  expenseDate DateTime @db.Date
  receiptUrl  String?
  approvedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus      Campus?  @relation(fields: [campusId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([campusId])
  @@index([category])
}

// -------------------------------------------------------------
// OPERATIONS
// -------------------------------------------------------------

model Notice {
  id             String         @id @default(uuid())
  tenantId       String
  title          String
  content        String         @db.Text
  targetAudience NoticeAudience @default(ALL)
  isUrgent       Boolean        @default(false)
  expiresAt      DateTime?
  publishedById  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([targetAudience])
}

model Notification {
  id        String    @id @default(uuid())
  tenantId  String?
  userId    String
  title     String
  message   String
  link      String?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  tenant    Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([isRead])
}

enum NotificationChannel {
  WHATSAPP
  SMS
  EMAIL
  PUSH
  IN_APP
}

enum NotificationDeliveryStatus {
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  FAILED
}

enum NotificationEventType {
  STUDENT_ABSENT
  FEE_DUE_REMINDER
  FEE_PAYMENT_RECEIPT
  EXAM_RESULT_PUBLISHED
  GENERAL_ANNOUNCEMENT
  BUS_DELAY_ALERT
}

model OutboundNotification {
  id              String                     @id @default(uuid())
  tenantId        String                     @db.VarChar(36)
  eventType       NotificationEventType
  channel         NotificationChannel        @default(WHATSAPP)
  recipientPhone  String?                    @db.VarChar(50)
  recipientEmail  String?                    @db.VarChar(191)
  recipientUserId String?                    @db.VarChar(36)
  recipientName   String?                    @db.VarChar(191)
  templateCode    String?                    @db.VarChar(100)
  title           String                     @db.VarChar(255)
  messageBody     String                     @db.Text
  payload         Json?
  status          NotificationDeliveryStatus @default(QUEUED)
  externalId      String?                    @db.VarChar(100)
  errorReason     String?                    @db.Text
  scheduledAt     DateTime?
  sentAt          DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  tenant          Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([eventType])
  @@index([channel])
  @@index([recipientPhone])
}

model LibraryBook {
  id              String      @id @default(uuid())
  tenantId        String
  campusId        String?
  isbn            String?
  title           String
  author          String
  publisher       String?
  edition         String?
  totalCopies     Int         @default(1)
  availableCopies Int         @default(1)
  rackLocation    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus          Campus?     @relation(fields: [campusId], references: [id], onDelete: SetNull)
  issues          BookIssue[]

  @@unique([tenantId, campusId, isbn])
  @@index([tenantId])
  @@index([campusId])
  @@index([title])
}

model BookIssue {
  id         String          @id @default(uuid())
  tenantId   String
  bookId     String
  userId     String
  issueDate  DateTime        @default(now())
  dueDate    DateTime
  returnDate DateTime?
  fineAmount Decimal         @default(0.00) @db.Decimal(8, 2)
  status     BookIssueStatus @default(ISSUED)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  book       LibraryBook     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([bookId])
  @@index([userId])
  @@index([status])
}

model TransportRoute {
  id         String    @id @default(uuid())
  tenantId   String
  campusId   String?
  routeName  String
  startPoint String
  endPoint   String
  stops      Json?
  fare       Decimal   @default(0.00) @db.Decimal(10, 2)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus     Campus?   @relation(fields: [campusId], references: [id], onDelete: SetNull)
  vehicles   Vehicle[]

  @@index([tenantId])
  @@index([campusId])
}

model Vehicle {
  id                 String          @id @default(uuid())
  tenantId           String
  campusId           String?
  routeId            String?
  registrationNumber String
  model              String?
  capacity           Int             @default(30)
  driverName         String?
  driverPhone        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus             Campus?         @relation(fields: [campusId], references: [id], onDelete: SetNull)
  route              TransportRoute? @relation(fields: [routeId], references: [id], onDelete: SetNull)

  @@unique([tenantId, registrationNumber])
  @@index([tenantId])
  @@index([campusId])
  @@index([routeId])
}

model HostelRoom {
  id           String   @id @default(uuid())
  tenantId     String
  campusId     String?
  hostelName   String
  roomNumber   String
  capacity     Int      @default(3)
  occupiedBeds Int      @default(0)
  monthlyFee   Decimal  @default(0.00) @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus       Campus?  @relation(fields: [campusId], references: [id], onDelete: SetNull)

  @@unique([tenantId, hostelName, roomNumber])
  @@index([tenantId])
  @@index([campusId])
}

model InventoryItem {
  id         String   @id @default(uuid())
  tenantId   String
  campusId   String?
  itemName   String
  category   String?
  quantity   Int      @default(0)
  unit       String?  @default("units")
  unitPrice  Decimal  @default(0.00) @db.Decimal(10, 2)
  location   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus     Campus?  @relation(fields: [campusId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([campusId])
}

// -------------------------------------------------------------
// HR & PAYROLL
// -------------------------------------------------------------

model PayrollPeriod {
  id             String          @id @default(uuid())
  tenantId       String
  name           String          // e.g. "October 2026"
  startDate      DateTime        @db.Date
  endDate        DateTime        @db.Date
  status         PayrollStatus   @default(DRAFT)
  totalDisbursed Decimal         @default(0.00) @db.Decimal(14, 2)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  records        PayrollRecord[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([status])
}

model PayrollRecord {
  id              String        @id @default(uuid())
  tenantId        String
  payrollPeriodId String
  staffProfileId  String
  basicSalary     Decimal       @db.Decimal(12, 2)
  allowances      Decimal       @default(0.00) @db.Decimal(12, 2)
  deductions      Decimal       @default(0.00) @db.Decimal(12, 2)
  netSalary       Decimal       @db.Decimal(12, 2)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentMethod   PaymentMethod @default(BANK_TRANSFER)
  paymentDate     DateTime?
  remarks         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  period          PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  staff           StaffProfile  @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@unique([tenantId, payrollPeriodId, staffProfileId])
  @@index([tenantId])
  @@index([payrollPeriodId])
  @@index([staffProfileId])
}
